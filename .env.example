# Copy to `.env.local` and fill in your values.
#
# Dropbox app key for the browser PKCE OAuth flow. Create a Dropbox app at
# https://www.dropbox.com/developers/apps with "App folder" access, then put
# its App key here. It is public by design (PKCE public client), not a secret.
VITE_DROPBOX_CLIENT_KEY=your_dropbox_app_key_here

# The Dropbox app folder the app syncs to. Set this to match the access level
# you selected (must include the leading slash). Example below is for an app
# whose dedicated folder is "learny".
VITE_DROPBOX_APP_FOLDER=/apps/learny

# ---------------------------------------------------------------------------
# AI word generation (Vercel serverless function `api/generate-words.ts`).
# These are SERVER-side env vars — set them in the Vercel project dashboard
# (Settings → Environment Variables), never in a frontend .env file.
# ---------------------------------------------------------------------------

# Required: your OpenRouter API key (https://openrouter.ai/keys). Only ever
# read by the serverless function; it is never sent to the browser.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: comma-separated model chain, tried in order until one returns a
# parseable list. Defaults to lightweight free models; set your own when the
# free roster rotates or you prefer a paid model.
# AI_MODEL=openai/gpt-oss-20b:free,arcee-ai/trinity-large-preview:free

# Optional: how many free generations each device gets per day (default 3).
# AI_DAILY_LIMIT=3

# Optional: bound a Vercel KV (Upstash) store to make the daily cap durable
# across serverless instances. Vercel injects KV_REST_API_URL and
# KV_REST_API_TOKEN automatically; without them the cap falls back to an
# in-process counter (approximate).
# AI_SUPPORTER_TOKEN=some_shared_secret
# AI_SUPPORTER_DAILY_LIMIT=50