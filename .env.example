# Copy to `.env.local` and fill in your values.
#
# Dropbox app key for the browser PKCE OAuth flow. Create a Dropbox app at
# https://www.dropbox.com/developers/apps with "App folder" access, then put
# its App key here. It is public by design (PKCE public client), not a secret.
VITE_DROPBOX_CLIENT_KEY=your_dropbox_app_key_here

# The Dropbox app folder the app syncs to. Set this to match the access level
# you selected (must include the leading slash). Example below is for an app
# whose dedicated folder is "learny".
VITE_DROPBOX_APP_FOLDER=/apps/learny